[Unit]
Description=Lunar Backend Service
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/lunar
ExecStart=/opt/lunar/server
Restart=always
RestartSec=5s
Environment=PORT=8081
Environment=ENV=production
EnvironmentFile=-/opt/lunar/.env

StandardOutput=journal
StandardError=journal
SyslogIdentifier=lunar-backend

LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
