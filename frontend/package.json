{
  "name": "lunar-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:auth": "playwright test tests/auth",
    "test:e2e:dashboard": "playwright test tests/dashboard",
    "test:e2e:copilot": "playwright test tests/copilot",
    "test:e2e:jira": "playwright test tests/jira",
    "test:e2e:bitbucket": "playwright test tests/bitbucket",
    "test:e2e:confluence": "playwright test tests/confluence",
    "test:e2e:settings": "playwright test tests/settings",
    "test:e2e:smoke": "playwright test --grep @p0",
    "test:e2e:positive": "playwright test --grep @positive",
    "test:e2e:negative": "playwright test --grep @negative",
    "test:e2e:edge": "playwright test --grep @edge"
  },
  "dependencies": {
    "@heroicons/vue": "^2.2.0",
    "@tailwindcss/vite": "^4.1.12",
    "three": "^0.186.1",
    "vue": "^3.5.18",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.13.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "docx": "^9.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.7.2",
    "vite": "^7.1.2",
    "vue-tsc": "^2.2.8"
  }
}
