{
  // OpenCode project configuration for lunar.
  //
  // OpenCode loads AGENTS.md automatically as the single source of truth for
  // engineering standards, anti-slop rules, and workflows. This configuration
  // enforces tool-level safety rails, execution permissions, and code formatting.
  "$schema": "https://opencode.ai/config.json",

  // Automatically format changed files after write/edit/patch operations.
  "formatter": true,

  // Ordered permission rules; the LAST matching rule wins.
  "permissions": [
    // Git safety: prevent accidental commits, pushes, and destructive resets
    { "action": "shell", "resource": "git commit *", "effect": "ask" },
    { "action": "shell", "resource": "git push *", "effect": "deny" },
    { "action": "shell", "resource": "git reset --hard *", "effect": "deny" },
    { "action": "shell", "resource": "git clean *", "effect": "ask" },

    // Protect credentials and environment secrets
    { "action": "edit", "resource": "*.env", "effect": "ask" },
    { "action": "edit", "resource": "*.env.*", "effect": "ask" },
    { "action": "edit", "resource": "*.env.example", "effect": "allow" }
  ]
}
